<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F2F8F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="600dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!--logo chugungo-->
        <ImageView
            android:layout_width="105dp"
            android:layout_height="105dp"
            android:src="@drawable/chungungo"
            android:contentDescription="Logo de Chungungo"
            android:scaleType="centerCrop"
            android:layout_marginBottom="12dp"/>

        <!--nombre de app-->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chungungo"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#176B60"
            android:layout_marginBottom="5dp"/>

        <!--descripcion-->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tu inventario del hogar"
            android:textSize="15sp"
            android:textColor="#777777"
            android:layout_marginBottom="28dp"/>

        <!--tarjeta login-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/fondo_registro"
            android:elevation="4dp"
            android:padding="20dp">

            <!--bienvenida -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bienvenido de nuevo"
                android:textAlignment="center"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#176B60"
                android:layout_marginBottom="22dp"/>

            <!--correo-->
            <EditText
                android:id="@+id/etCorreo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Correo electrónico"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:textSize="14sp"
                android:padding="14dp"
                android:background="@drawable/fondo_campo"
                android:layout_marginBottom="14dp"/>

            <!--contraseña-->
            <EditText
                android:id="@+id/etContrasena"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Contraseña"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textSize="14sp"
                android:padding="14dp"
                android:background="@drawable/fondo_campo"
                android:layout_marginBottom="22dp"/>

            <!--boton iniciar sesion-->
            <Button
                android:id="@+id/btnIniciarSesion"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Iniciar sesión"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#176B60"/>

            <!--ir a registrarse-->
            <TextView
                android:id="@+id/tvRegistrarse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="¿No tienes cuenta? Regístrate"
                android:textAlignment="center"
                android:textColor="#176B60"
                android:textSize="14sp"
                android:padding="12dp"
                android:layout_marginTop="12dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
